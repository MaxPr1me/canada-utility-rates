# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Data (keep schema and exports, ignore large temp files)
data/db/*.db
!data/db/.gitkeep
data/db/backups/
data/exports/*.csv
data/exports/*.xlsx
!data/exports/.gitkeep

# Excel audit/reference files (not system of record)
data/excel/

# Logs
logs/
*.log

# Local task tracker and campaign history
.local/

# Environment
.env
.env.local

# Temporary scrape artifacts
scrapers/temp/
*.tmp

# Graphify code graph (owner decision 2026-11-03): commit only the generated views
# and their small config/label files. Caches, manifests, build state, absolute-path
# markers and temporary files stay local. scripts/graphify_hook.py commits exactly
# what this block allows.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/GRAPH_TREE.html
!graphify-out/GRAPH_CALLFLOW.html
!graphify-out/wiki/
!graphify-out/.graphify_build.json
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_labels.json.sig
!graphify-out/.graphify_labels.pending.json
