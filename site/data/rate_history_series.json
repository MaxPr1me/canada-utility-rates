{
  "version": 1,
  "kind": "rate_history_series",
  "reviewed": "2026-11-24",
  "decided": "owner decisions 45, 55 and 56 (2026-11-23)",
  "rule": "Each series reads only live stored records (estimates are never charted). 'match' selects records: province and utility_type, optionally utility_name (exact), plus 'requires' and 'excludes' component patterns (component_type, tou_period, name_regex). Each line selects components by component_type, name_regex, optional tariff_code_regex and tou_period. Every *_regex is a full match. A series is shown once: when several records carry a line, they must show the same value for each effective date; where they differ, the chart shows each value separately with how many tariffs carry it and never picks one. Medicine Hat's monthly rate is not a series (decision 56).",
  "series": [
    {
      "id": "on-rpp-tou",
      "family": "regulated",
      "group": "Ontario Regulated Price Plan",
      "label": "Time-of-Use",
      "province": "ON",
      "fuel": "electricity",
      "match": {
        "province": "ON",
        "utility_type": "electricity",
        "requires": [
          {
            "component_type": "energy",
            "tou_period": "on-peak"
          }
        ],
        "excludes": [
          {
            "tou_period": "ultra-low-overnight"
          }
        ]
      },
      "lines": [
        {
          "id": "off-peak",
          "label": "Off-peak",
          "component_type": "energy",
          "name_regex": "^Off-Peak Energy$",
          "tou_period": "off-peak"
        },
        {
          "id": "mid-peak",
          "label": "Mid-peak",
          "component_type": "energy",
          "name_regex": "^Mid-Peak Energy$",
          "tou_period": "mid-peak"
        },
        {
          "id": "on-peak",
          "label": "On-peak",
          "component_type": "energy",
          "name_regex": "^On-Peak Energy$",
          "tou_period": "on-peak"
        }
      ],
      "note": "Set by the Ontario Energy Board and identical at every Ontario distributor's Time-of-Use tariffs."
    },
    {
